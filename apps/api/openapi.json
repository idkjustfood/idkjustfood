{
  "openapi": "3.1.0",
  "info": {
    "title": "idkjustfood API",
    "version": "0.0.1",
    "description": "Sign-in and sessions are handled by Better Auth under /api/auth/*. Signed-in requests send the session cookie it sets."
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Session cookie set by Better Auth when you sign in."
      }
    },
    "schemas": {
      "Household": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "Your role in this household",
            "example": "member"
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Household not found"
          }
        },
        "required": [
          "error"
        ]
      },
      "Member": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Membership id (not the user id)"
          },
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "\"owner\" or \"member\"",
            "example": "member"
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "userId",
          "name",
          "email",
          "role",
          "joinedAt"
        ]
      },
      "Invite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Secret code of the invite link. Owners only."
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Full invite link, built from the server's APP_URL. Null when APP_URL is not set; clients then build the link themselves as <app>/invite/<id>."
          },
          "inviterName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "url",
          "inviterName",
          "createdAt",
          "expiresAt"
        ]
      },
      "InvitePreview": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "householdId": {
            "type": "string"
          },
          "householdName": {
            "type": "string"
          },
          "inviterName": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "alreadyMember": {
            "type": "boolean",
            "description": "You are already in this household"
          }
        },
        "required": [
          "id",
          "householdId",
          "householdName",
          "inviterName",
          "expiresAt",
          "alreadyMember"
        ]
      },
      "Recipe": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "servings": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "prepMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100000
          },
          "cookMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100000
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[^,]+$"
            },
            "maxItems": 30
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "quantity": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 40
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "name",
                "quantity",
                "unit",
                "note"
              ]
            },
            "maxItems": 200
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "text"
              ]
            },
            "maxItems": 200
          },
          "nutrition": {
            "type": "object",
            "properties": {
              "calories": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100000
              },
              "protein": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 10000
              },
              "carbs": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 10000
              },
              "fat": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 10000
              }
            },
            "required": [
              "calories",
              "protein",
              "carbs",
              "fat"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "manual",
                  "video",
                  "website",
                  "photo",
                  "text",
                  "import"
                ]
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2000
              }
            },
            "required": [
              "kind",
              "label",
              "url"
            ]
          },
          "id": {
            "type": "string"
          },
          "householdId": {
            "type": [
              "string",
              "null"
            ]
          },
          "userId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "description",
          "servings",
          "prepMinutes",
          "cookMinutes",
          "tags",
          "ingredients",
          "steps",
          "nutrition",
          "source",
          "id",
          "householdId",
          "userId",
          "createdAt",
          "updatedAt"
        ]
      },
      "RecipeInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "servings": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "prepMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100000
          },
          "cookMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100000
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[^,]+$"
            },
            "maxItems": 30
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "quantity": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 40
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "name",
                "quantity",
                "unit",
                "note"
              ]
            },
            "maxItems": 200
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "text"
              ]
            },
            "maxItems": 200
          },
          "nutrition": {
            "type": "object",
            "properties": {
              "calories": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100000
              },
              "protein": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 10000
              },
              "carbs": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 10000
              },
              "fat": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 10000
              }
            },
            "required": [
              "calories",
              "protein",
              "carbs",
              "fat"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "manual",
                  "video",
                  "website",
                  "photo",
                  "text",
                  "import"
                ]
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 2000
              }
            },
            "required": [
              "kind",
              "label",
              "url"
            ]
          },
          "householdId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "title",
          "description",
          "servings",
          "prepMinutes",
          "cookMinutes",
          "tags",
          "ingredients",
          "steps",
          "nutrition"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/households": {
      "get": {
        "tags": [
          "Households"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "List the households you belong to",
        "responses": {
          "200": {
            "description": "Households",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "households": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Household"
                      }
                    }
                  },
                  "required": [
                    "households"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Households"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "Create a household. You become its owner.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "household": {
                      "$ref": "#/components/schemas/Household"
                    }
                  },
                  "required": [
                    "household"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/households/{householdId}/members": {
      "get": {
        "tags": [
          "Households"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "List the members of a household",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "householdId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Members",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "members": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Member"
                      }
                    }
                  },
                  "required": [
                    "members"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Household not found, or you are not a member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/households/{householdId}/members/{memberId}": {
      "delete": {
        "tags": [
          "Households"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "Remove a member from a household (owners only)",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "householdId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "memberId",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Done"
          },
          "400": {
            "description": "You can't remove yourself or another owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Only owners of the household can do this",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Household not found, or you are not a member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/households/{householdId}/leave": {
      "post": {
        "tags": [
          "Households"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "Leave a household",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "householdId",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Done"
          },
          "400": {
            "description": "The only owner can't leave",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Household not found, or you are not a member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/households/{householdId}/invites": {
      "get": {
        "tags": [
          "Households"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "List pending invite links (owners only)",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "householdId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Pending invites",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "invites": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Invite"
                      }
                    }
                  },
                  "required": [
                    "invites"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Only owners of the household can do this",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Household not found, or you are not a member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Households"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "Create an invite link (owners only)",
        "description": "Anyone who opens the link and accepts joins the household as a member. The link works once and expires after 7 days. No email service is needed.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "householdId",
            "in": "path"
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "invite": {
                      "$ref": "#/components/schemas/Invite"
                    }
                  },
                  "required": [
                    "invite"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Only owners of the household can do this",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Household not found, or you are not a member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/households/{householdId}/invites/{inviteId}": {
      "delete": {
        "tags": [
          "Households"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "Cancel an invite link (owners only). The link stops working.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "householdId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "inviteId",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Done"
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Only owners of the household can do this",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Household not found, or you are not a member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/invites/{inviteId}": {
      "get": {
        "tags": [
          "Households"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "Look at an invite before accepting or declining it",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "inviteId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Invite",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "invite": {
                      "$ref": "#/components/schemas/InvitePreview"
                    }
                  },
                  "required": [
                    "invite"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The invite doesn't exist, was used or cancelled, or has expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/invites/{inviteId}/accept": {
      "post": {
        "tags": [
          "Households"
        ],
        "security": [
          {
