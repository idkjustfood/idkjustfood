# Copy to .env and adjust. Used by docker-compose.yml.

# Database (the compose file builds DATABASE_URL from these)
POSTGRES_USER=idkjustfood
POSTGRES_PASSWORD=change-me
POSTGRES_DB=idkjustfood

# Public URLs, as the browser sees them (set by your reverse proxy / domain)
API_URL=https://api.example.com
APP_URL=https://app.example.com

# Auth (Better Auth)
# Secret used to sign sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Who can register: first-user-only (default), invite or open.
#   first-user-only: the first account becomes the admin, later sign-ups are rejected.
#   invite:          new accounts need a household invite link (the first account is still free).
#   open:            anyone can register. Only choose this on purpose.
SIGNUP_MODE=first-user-only
# Optional OAuth sign-in. A provider is only active when both its ID and secret are set.
# Callback URLs: <API_URL>/api/auth/callback/google and <API_URL>/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI provider. Any provider can be used; OpenRouter is the default and the only one built in so far.
# The key is needed to read videos, photos and pasted text. Websites with recipe data work without it.
AI_PROVIDER=openrouter
AI_API_KEY=
# Optional: base URL for self-hosted or compatible providers (for example Ollama)
AI_BASE_URL=
# Optional: the model for each job. Empty means the provider's default.
#   transcription: speech to text (needs a model that accepts audio)
#   vision:        reading photos and video frames (needs a model that accepts images)
#   parsing:       turning text into a recipe
AI_TRANSCRIPTION_MODEL=
AI_VISION_MODEL=
AI_PARSING_MODEL=
# Optional: a job can use another provider, key or base URL, for example
# AI_TRANSCRIPTION_PROVIDER=, AI_TRANSCRIPTION_API_KEY=, AI_TRANSCRIPTION_BASE_URL=
# (the same for AI_VISION_* and AI_PARSING_*). See docs/ai-providers.md.
