# Copy to .env and adjust. Used by docker-compose.yml.

# Database (the compose file builds DATABASE_URL from these)
POSTGRES_USER=idkjustfood
POSTGRES_PASSWORD=change-me
POSTGRES_DB=idkjustfood

# Public URLs, as the browser sees them (set by your reverse proxy / domain)
API_URL=https://api.example.com
APP_URL=https://app.example.com

# AI provider. Any provider can be used; OpenRouter is the default.
AI_PROVIDER=openrouter
AI_API_KEY=
# Optional: base URL for self-hosted or compatible providers (for example Ollama)
AI_BASE_URL=
# Optional: models for transcription and recipe parsing
AI_TRANSCRIPTION_MODEL=
AI_PARSING_MODEL=
