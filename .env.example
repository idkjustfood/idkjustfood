# Copy to .env and fill in. Bun loads .env automatically.

# Required: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional overrides (defaults shown)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Reads caption + transcript + video frames; must accept images.
# PARSE_MODEL=google/gemini-3.5-flash
# Turns the audio into text; must accept audio input.
# TRANSCRIBE_MODEL=google/gemini-3.5-flash-lite
# MAX_FRAMES=30
# WORK_DIR=work
